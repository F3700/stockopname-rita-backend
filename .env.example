# Salin berkas ini menjadi .env lalu isi nilainya.
# Berkas .env tidak pernah ikut commit.

# --- Server ---------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8080
DATABASE_URL=postgres://user:password@127.0.0.1:5432/stockopname?sslmode=disable

# --- Login admin ----------------------------------------------------------
# Wajib. Tanpa keduanya server menolak start, bukan diam-diam membuka semua
# endpoint. Buat hash dengan:
#
#   go run ./cmd/hashpw
#
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=pbkdf2-sha256:210000:GANTI_DENGAN_SALT:GANTI_DENGAN_KEY

# Kunci tanda tangan cookie. Minimal 32 karakter acak:
#   openssl rand -hex 32
# Mengganti nilai ini memaksa semua orang login ulang.
SESSION_SECRET=GANTI_DENGAN_32_KARAKTER_ACAK

# Masa berlaku sesi. Satu shift kerja.
SESSION_TTL=12h

# --- Cookie ---------------------------------------------------------------
# true di produksi (https). Set false hanya untuk dev lewat http, karena
# browser membuang cookie Secure dari koneksi biasa.
COOKIE_SECURE=true

# Kosong = cookie hanya untuk host yang menyajikannya, yang benar saat API
# diproxy same-origin di /api. Isi hanya bila API dan SPA beda host.
COOKIE_DOMAIN=

# --- CORS -----------------------------------------------------------------
# Daftar origin dipisahkan koma. Saat SPA memakai proxy /api, CORS tidak
# terpakai sama sekali; isi ini hanya untuk akses lintas-origin.
CORS_ALLOWED_ORIGINS=https://rita.albertt.my.id

# --- Batas ----------------------------------------------------------------
# 64 MiB, cukup untuk dua berkas DBF data master toko besar.
HTTP_MAX_BODY_BYTES=67108864
# 3 menit memberi ruang untuk ekspor PDF/Excel/DBF.
HTTP_WRITE_TIMEOUT=3m
# Batas baris satu laporan ekspor dan berapa laporan boleh dibuat serentak.
REPORT_MAX_ROWS=20000
REPORT_MAX_CONCURRENT=2
