{
  "openapi": "3.0.3",
  "info": {
    "title": "Rita Stock Opname API",
    "version": "1.0.0",
    "description": "REST API untuk mendukung proses stock opname, pengelolaan produk, dan pemantauan hasil stock opname."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development"
    },
    {
      "url": "https://albertt....",
      "description": "Hosted Development"
    }
  ],
  "tags": [
    {
      "name": "Products",
      "description": "Endpoint untuk pengelolaan data produk"
    },
    {
      "name": "Stock Opname Session",
      "description": "Endpoint untuk proses stock opname"
    }
  ],
  "paths": {
    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "Get products",
        "description": "Retrieve a list of products, optionally filtered by their last update timestamp.",
        "parameters": [
          {
            "name": "updated_after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-08-14T10:00:00Z"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Products retrieved successfully"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": ["Products"],
        "summary": "Create a new product",
        "description": "Create a new product with the provided details.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "$ref": "#/components/schemas/CreateProductRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Product created successfully"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/products/{id}": {
      "patch": {
        "tags": ["Products"],
        "summary": "Update an existing product",
        "description": "Update the details of an existing product.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Product updated successfully"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": ["Products"],
        "summary": "Delete a product",
        "description": "Delete an existing product by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Product deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Product deleted successfully"
                    },
                    "data": {
                      "type": "string",
                      "example": ""
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/products/deleted": {
      "get": {
        "tags": ["Products"],
        "summary": "Get deleted products",
        "description": "Retrieve a list of products that have been deleted, optionally filtered by their last update timestamp.",
        "parameters": [
          {
            "name": "updated_after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-08-14T10:00:00Z"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Deleted products retrieved successfully"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DeletedProduct"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/so-sessions/join": {
      "post": {
        "tags": ["Stock Opname Session"],
        "summary": "Join a stock opname session",
        "description": "Join an inspector or scanner to an existing stock opname session.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sesi_code": {
                    "type": "string",
                    "example": "SO-2026-06-03-01"
                  },
                  "coor_code": {
                    "type": "string",
                    "example": "KOOR1"
                  },
                  "inspector_code": {
                    "type": "string",
                    "example": "INSPECTOR1"
                  },
                  "rak": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": ["RAK1", "RAK2"]
                  }
                },
                "required": ["sesi_code", "coor_code", "inspector_code", "rak"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Join session successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Successfully joined the stock opname session."
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "inspector_id": {
                          "type": "integer",
                          "example": 132
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/so-sessions/rak": {
      "post": {
        "tags": ["Stock Opname Session"],
        "summary": "Post SO products by racks for a stock opname session",
        "description": "Post the products associated with specific racks for a given stock opname session.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rak_id": {
                    "type": "string",
                    "example": "12323"
                  },
                  "so_products": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "product_id": {
                          "type": "integer",
                          "example": 1
                        },
                        "quantity": {
                          "type": "integer",
                          "example": 10
                        }
                      },
                      "required": ["product_id", "quantity"]
                    }
                  }
                },
                "required": ["rak_id", "so_products"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Racks posted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Racks posted successfully."
                    },
                    "data": {
                      "type": "string",
                      "example": ""
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "required": [
          "id",
          "barcode",
          "name",
          "buy_price",
          "sell_price",
          "date_created",
          "date_updated",
          "category_name",
          "department_code"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "barcode": {
            "type": "string",
            "example": "1234567890123"
          },
          "name": {
            "type": "string",
            "example": "Product A"
          },
          "buy_price": {
            "type": "number",
            "format": "double",
            "example": 9.99
          },
          "sell_price": {
            "type": "number",
            "format": "double",
            "example": 19.99
          },
          "date_created": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-01T12:00:00Z"
          },
          "date_updated": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-02T12:00:00Z"
          },
          "category_name": {
            "type": "string",
            "example": "Diary"
          },
          "department_code": {
            "type": "string",
            "example": "NSTL"
          }
        }
      },
      "CreateProductRequest": {
        "type": "object",
        "required": [
          "barcode",
          "name",
          "buy_price",
          "sell_price",
          "category_name",
          "department_code"
        ],
        "properties": {
          "barcode": {
            "type": "string",
            "example": "1234567890123"
          },
          "name": {
            "type": "string",
            "example": "Product A"
          },
          "buy_price": {
            "type": "number",
            "format": "double",
            "example": 9.99
          },
          "sell_price": {
            "type": "number",
            "format": "double",
            "example": 19.99
          },
          "category_name": {
            "type": "string",
            "example": "Diary"
          },
          "department_code": {
            "type": "string",
            "example": "NSTL"
          }
        }
      },
      "UpdateProductRequest": {
        "type": "object",
        "properties": {
          "barcode": {
            "type": "string",
            "example": "1234567890123"
          },
          "name": {
            "type": "string",
            "example": "Product A"
          },
          "buy_price": {
            "type": "number",
            "format": "double",
            "example": 9.99
          },
          "sell_price": {
            "type": "number",
            "format": "double",
            "example": 19.99
          },
          "category_name": {
            "type": "string",
            "example": "Diary"
          },
          "department_code": {
            "type": "string",
            "example": "NSTL"
          }
        }
      },
      "DeletedProduct": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "InternalServerErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Failed: Internal server error"
          },
          "data": {
            "type": "string",
            "example": ""
          }
        }
      }
    },
    "responses": {
      "InternalServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/InternalServerErrorResponse"
            }
          }
        }
      }
    },
    "parameters": {},
    "securitySchemes": {}
  }
}
